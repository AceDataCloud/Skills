{
  "name": "kling",
  "version": "0.1.0",
  "displayName": "Kling",
  "description": "Create Kling videos from text or a reference image and retrieve results through Ace Data Cloud.",
  "author": {
    "name": "Ace Data Cloud",
    "email": "support@acedata.cloud"
  },
  "homepage": "https://github.com/AceDataCloud/Skills/tree/main/claude-plugins/kling",
  "repository": "https://github.com/AceDataCloud/Skills",
  "license": "Apache-2.0",
  "keywords": [
    "kling",
    "video-generation",
    "image-to-video",
    "ace-data-cloud"
  ],
  "userConfig": {
    "api_token": {
      "type": "string",
      "title": "Ace Data Cloud API Token",
      "description": "Use a dedicated Ace Data Cloud application token with Kling access. Enter the raw token.",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "kling": {
      "command": "uvx",
      "args": [
        "mcp-kling==2026.11.27.0"
      ],
      "env": {
        "ACEDATACLOUD_API_TOKEN": "${user_config.api_token}"
      }
    }
  },
  "icon": "./assets/service-icon.png",
  "documentationUrl": "https://github.com/AceDataCloud/Skills/tree/main/claude-plugins/kling",
  "privacyPolicyUrl": "https://platform.acedata.cloud/privacy",
  "termsOfServiceUrl": "https://platform.acedata.cloud/terms",
  "supportUrl": "https://platform.acedata.cloud/support"
}
