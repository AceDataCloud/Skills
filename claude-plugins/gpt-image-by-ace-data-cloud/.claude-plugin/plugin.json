{
  "name": "gpt-image-by-ace-data-cloud",
  "version": "0.1.0",
  "description": "GPT Image by Ace Data Cloud: image generation and same-task retrieval through your Ace account. Separate paid API service; not the model vendor's official plugin.",
  "author": {
    "name": "Ace Data Cloud",
    "email": "support@acedata.cloud"
  },
  "homepage": "https://github.com/AceDataCloud/Skills/tree/main/claude-plugins/gpt-image-by-ace-data-cloud",
  "repository": "https://github.com/AceDataCloud/Skills",
  "license": "Apache-2.0",
  "keywords": [
    "gpt-image",
    "image",
    "ace-data-cloud"
  ],
  "userConfig": {
    "api_token": {
      "type": "string",
      "title": "Ace Data Cloud API Token",
      "description": "Paste a dedicated Ace service API Token with GPT Image access. Raw token only; not an Anthropic, model-vendor or platform management key.",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "gpt-image": {
      "command": "uvx",
      "args": [
        "mcp-openai-pro==2026.10.19.3",
        "--profile",
        "gpt-image"
      ],
      "env": {
        "ACEDATACLOUD_API_TOKEN": "${user_config.api_token}"
      }
    }
  },
  "displayName": "GPT Image by Ace Data Cloud",
  "icon": "./assets/ace-data-cloud-mark.png",
  "documentationUrl": "https://github.com/AceDataCloud/Skills/tree/main/claude-plugins/gpt-image-by-ace-data-cloud",
  "privacyPolicyUrl": "https://platform.acedata.cloud/privacy",
  "termsOfServiceUrl": "https://platform.acedata.cloud/terms",
  "supportUrl": "https://platform.acedata.cloud/support"
}
