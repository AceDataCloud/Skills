{
  "name": "seedream-by-ace-data-cloud",
  "version": "0.1.1",
  "description": "Generate or edit Seedream images from a prompt and selected reference images through Ace Data Cloud.",
  "author": {
    "name": "Ace Data Cloud",
    "email": "support@acedata.cloud"
  },
  "homepage": "https://github.com/AceDataCloud/Skills/tree/main/claude-plugins/seedream-by-ace-data-cloud",
  "repository": "https://github.com/AceDataCloud/Skills",
  "license": "Apache-2.0",
  "keywords": [
    "seedream",
    "image-generation",
    "image-editing",
    "ace-data-cloud"
  ],
  "userConfig": {
    "api_token": {
      "type": "string",
      "title": "Ace Data Cloud API Token",
      "description": "Use a dedicated Ace Data Cloud application token with Seedream access. Enter the raw token.",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "seedream": {
      "type": "http",
      "url": "https://seedream.mcp.acedata.cloud/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.api_token}"
      }
    }
  },
  "displayName": "Seedream",
  "icon": "./assets/service-icon.png",
  "documentationUrl": "https://github.com/AceDataCloud/Skills/tree/main/claude-plugins/seedream-by-ace-data-cloud",
  "privacyPolicyUrl": "https://platform.acedata.cloud/privacy",
  "termsOfServiceUrl": "https://platform.acedata.cloud/terms",
  "supportUrl": "https://platform.acedata.cloud/support"
}
